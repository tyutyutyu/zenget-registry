{
  "schema_version": 1,
  "repository": "jqlang/jq",
  "supported_systems": [
    "darwin/amd64",
    "darwin/arm64",
    "linux/amd64",
    "linux/arm64"
  ],
  "asset_selector": {
    "version": 1,
    "type": "regex",
    "pattern": "^jq-(linux-amd64|linux-arm64|macos-amd64|macos-arm64)$"
  },
  "checksum": {
    "type": "regex",
    "pattern": "^sha256sum\\.txt$",
    "format": "sha256sum"
  }
}
